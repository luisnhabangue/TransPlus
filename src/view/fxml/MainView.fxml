<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="820.0" prefWidth="1360.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainViewController">

    <!-- MENU LATERAL FIXO A ESQUERDA -->
    <left>
        <VBox styleClass="sidebar" BorderPane.alignment="CENTER">
            <!-- Logotipo -->
            <HBox alignment="CENTER_LEFT" spacing="11.0">
                <padding>
                    <Insets top="28.0" right="22.0" bottom="20.0" left="24.0"/>
                </padding>
                <StackPane styleClass="brand-mark">
                    <Label text="🚛" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px;"/>
                    <Region styleClass="brand-dot" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin>
                            <Insets top="-2.0" right="-2.0"/>
                        </StackPane.margin>
                    </Region>
                </StackPane>
                <VBox spacing="1.0">
                    <HBox alignment="BASELINE_LEFT">
                        <Label text="TransCarga" styleClass="brand-name"/>
                        <Label text="." styleClass="brand-name-accent"/>
                    </HBox>
                    <Label text="MOÇAMBIQUE" styleClass="brand-location"/>
                </VBox>
            </HBox>

            <!-- Etiqueta do Sistema -->
            <HBox alignment="CENTER" spacing="8.0" styleClass="workspace-pill">
                <VBox.margin>
                    <Insets left="20.0" right="20.0"/>
                </VBox.margin>
                <Region styleClass="dot-orange"/>
                <Label text="Sistema de Gestão Logística" style="-fx-text-fill: #6D7B8E; -fx-font-size: 10.5px;"/>
            </HBox>

            <!-- Rotulo de Navegacao -->
            <Label text="ÁREA DE GESTÃO" styleClass="nav-section-label">
                <VBox.margin>
                    <Insets top="32.0" left="26.0" bottom="12.0"/>
                </VBox.margin>
            </Label>

            <!-- Botoes do Menu -->
            <VBox spacing="6.0">
                <padding>
                    <Insets left="14.0" right="14.0"/>
                </padding>
                <Button fx:id="btnNavProprietarios" text="👥   Proprietários" maxWidth="Infinity"
                        styleClass="nav-button-active" onAction="#abrirProprietarios"/>

                <Button fx:id="btnNavVeiculos" text="🚛   Frota de Veículos" maxWidth="Infinity"
                        styleClass="nav-button" onAction="#abrirVeiculos"/>

                <Button fx:id="btnNavClientes" text="🏢   Clientes" maxWidth="Infinity"
                        styleClass="nav-button" onAction="#abrirClientes"/>

                <Button fx:id="btnNavCarregamentos" text="📦   Carregamentos &amp; Transportes" maxWidth="Infinity"
                        wrapText="true" styleClass="nav-button" onAction="#abrirCarregamentos"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Cartao de Ajuda e Estado -->
            <VBox spacing="14.0">
                <padding>
                    <Insets top="20.0" right="18.0" bottom="16.0" left="18.0"/>
                </padding>
                <VBox spacing="6.0" styleClass="support-card">
                    <Label text="Precisa de uma mão?" styleClass="support-title"/>
                    <Label text="Gestão baseada em Árvore Binária de Pesquisa (ABP)." wrapText="true" styleClass="support-text"/>
                    <Button text="Centro de ajuda  →" styleClass="link-button" onAction="#abrirAjuda"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="7.0">
                    <Region styleClass="dot-green"/>
                    <Label text="Sistema operacional" styleClass="sidebar-footer-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="v1.0" style="-fx-font-size: 10px; -fx-text-fill: #ACB5C2;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- AREA DIREITA: TOPBAR + CONTEUDO -->
    <center>
        <BorderPane>
            <!-- Topbar -->
            <top>
                <HBox alignment="CENTER_LEFT" styleClass="topbar">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Gestão" styleClass="breadcrumb-muted"/>
                        <Label text="›" styleClass="breadcrumb-muted"/>
                        <Label fx:id="lblBreadcrumb" text="Proprietários" styleClass="breadcrumb-active"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT" spacing="18.0">
                        <HBox alignment="CENTER" spacing="7.0">
                            <Region styleClass="dot-orange"/>
                            <Label text="Moçambique" style="-fx-font-size: 11px; -fx-text-fill: #758299;"/>
                        </HBox>
                        <Region styleClass="topbar-divider"/>
                        <HBox alignment="CENTER" spacing="10.0">
                            <StackPane styleClass="avatar-circle">
                                <Label text="AM" style="-fx-text-fill: #365596; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="1.0">
                                <Label text="Administrador" style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #445167;"/>
                                <Label text="Gestão da operação" style="-fx-font-size: 10px; -fx-text-fill: #98A3B3;"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </HBox>
            </top>

            <!-- Contentor dinamico das 4 telas -->
            <center>
                <ScrollPane fitToWidth="true" styleClass="main-scroll">
                    <content>
                        <StackPane fx:id="contentArea">
                            <padding>
                                <Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/>
                            </padding>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>